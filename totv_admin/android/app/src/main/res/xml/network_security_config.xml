<?xml version="1.0" encoding="utf-8"?>
<!-- سيرفرات Xtream تعمل غالباً على http — نسمح بها لفحص السيرفرات من التطبيق -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
